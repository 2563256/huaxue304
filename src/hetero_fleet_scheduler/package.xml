<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hetero_fleet_scheduler</name>
  <version>0.1.0</version>
  <description>Task model, greedy cost-based allocation, fleet state machine and metrics.</description>
  <maintainer email="dev@example.com">fleet dev</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>hetero_fleet_msgs</depend>
  <depend>hetero_fleet_description</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_python</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
