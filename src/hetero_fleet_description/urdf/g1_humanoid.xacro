    <visual>
      <geometry>
        <cylinder radius=".025" length=".035" />
      </geometry>
    </visual>
  </link>
  <joint name="g1_lidar_joint" type="fixed">
    <parent link="pelvis" />
    <child link="lidar_link" />
    <origin xyz="0 0 0.56" />
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="$(arg robot_name)_lidar" type="gpu_lidar">
      <always_on>1</always_on>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <topic>/$(arg robot_name)/scan</topic>
      <frame_id>lidar_link</frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>.12</min>
          <max>12.0</max>
          <resolution>.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="left_ankle_roll_link">
