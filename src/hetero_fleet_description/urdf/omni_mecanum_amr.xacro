<?xml version="1.0"?>
<!-- Reduced uniformly by 10% for fleet clearance; collision outline 1.2857139 x 1.125 m. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="omni_mecanum_amr">
  <xacro:arg name="robot_name" default="omni_1"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:include filename="$(find hetero_fleet_description)/urdf/common.xacro"/>
  <xacro:property name="controllers_file" value="$(arg controllers_file)"/>
  <xacro:property name="robot_name" value="$(arg robot_name)"/>
  <xacro:property name="s" value="1.339285714290"/>
  <xacro:property name="base_length" value="${0.90 * s}"/>
  <xacro:property name="base_width" value="${0.70 * s}"/>
  <xacro:property name="base_height" value="${0.20 * s}"/>
  <xacro:property name="wheel_radius" value="${0.095 * s}"/>
  <xacro:property name="wheel_width" value="${0.070 * s}"/>
  <link name="base_footprint"/>
  <link name="base_link">
    <inertial><origin xyz="0 0 ${base_height / 2}"/><mass value="${42.0 * s**3}"/><inertia ixx="${42.0 * s**3 * (base_width**2 + base_height**2) / 12}" ixy="0" ixz="0" iyy="${42.0 * s**3 * (base_length**2 + base_height**2) / 12}" iyz="0" izz="${42.0 * s**3 * (base_length**2 + base_width**2) / 12}"/></inertial>
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://hetero_fleet_description/meshes/omni_shell.stl" scale="${s} ${s} ${s}"/></geometry><material name="red"><color rgba="0.78 0.10 0.12 1"/></material></visual>
    <collision><origin xyz="0 0 ${base_height / 2}"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry></collision>
  </link>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${wheel_radius}"/></joint>
  <link name="underbody_link"><visual><origin xyz="0 0 ${0.06 * s}"/><geometry><box size="${0.82 * s} ${0.62 * s} ${0.12 * s}"/></geometry><material name="underbody"><color rgba="0.14 0.15 0.16 1"/></material></visual><collision><origin xyz="0 0 ${0.06 * s}"/><geometry><box size="${0.82 * s} ${0.62 * s} ${0.12 * s}"/></geometry></collision></link>
  <joint name="underbody_joint" type="fixed"><parent link="base_link"/><child link="underbody_link"/><origin xyz="0 0 ${0.01 * s}"/></joint>
  <link name="omni_bumper_link"><visual><origin xyz="0 0 ${0.045 * s}"/><geometry><box size="${0.96 * s} ${0.76 * s} ${0.09 * s}"/></geometry><material name="bumper"><color rgba="0.10 0.11 0.13 1"/></material></visual><collision><origin xyz="0 0 ${0.045 * s}"/><geometry><box size="${0.96 * s} ${0.76 * s} ${0.09 * s}"/></geometry></collision></link>
  <joint name="omni_bumper_joint" type="fixed"><parent link="base_link"/><child link="omni_bumper_link"/><origin xyz="0 0 ${0.03 * s}"/></joint>
  <link name="omni_deck_link"><visual><origin xyz="0 0 ${0.035 * s}"/><geometry><box size="${0.72 * s} ${0.54 * s} ${0.08 * s}"/></geometry><material name="deck"><color rgba="0.68 0.12 0.12 1"/></material></visual><collision><origin xyz="0 0 ${0.035 * s}"/><geometry><box size="${0.72 * s} ${0.54 * s} ${0.08 * s}"/></geometry></collision></link>
  <joint name="omni_deck_joint" type="fixed"><parent link="base_link"/><child link="omni_deck_link"/><origin xyz="0 0 ${base_height}"/></joint>

  <link name="front_left_corner_guard"><visual><origin xyz="0 0 ${0.12 * s}"/><geometry><cylinder radius="${0.05 * s}" length="${0.24 * s}"/></geometry><material name="guard"><color rgba="0.08 0.09 0.10 1"/></material></visual><collision><origin xyz="0 0 ${0.12 * s}"/><geometry><cylinder radius="${0.05 * s}" length="${0.24 * s}"/></geometry></collision></link>
  <joint name="front_left_corner_guard_joint" type="fixed"><parent link="base_link"/><child link="front_left_corner_guard"/><origin xyz="${0.39 * s} ${0.29 * s} 0"/></joint>
  <link name="front_right_corner_guard"><visual><origin xyz="0 0 ${0.12 * s}"/><geometry><cylinder radius="${0.05 * s}" length="${0.24 * s}"/></geometry><material name="guard"><color rgba="0.08 0.09 0.10 1"/></material></visual><collision><origin xyz="0 0 ${0.12 * s}"/><geometry><cylinder radius="${0.05 * s}" length="${0.24 * s}"/></geometry></collision></link>
  <joint name="front_right_corner_guard_joint" type="fixed"><parent link="base_link"/><child link="front_right_corner_guard"/><origin xyz="${0.39 * s} ${-0.29 * s} 0"/></joint>
  <link name="rear_left_corner_guard"><visual><origin xyz="0 0 ${0.12 * s}"/><geometry><cylinder radius="${0.05 * s}" length="${0.24 * s}"/></geometry><material name="guard"><color rgba="0.08 0.09 0.10 1"/></material></visual><collision><origin xyz="0 0 ${0.12 * s}"/><geometry><cylinder radius="${0.05 * s}" length="${0.24 * s}"/></geometry></collision></link>
  <joint name="rear_left_corner_guard_joint" type="fixed"><parent link="base_link"/><child link="rear_left_corner_guard"/><origin xyz="${-0.39 * s} ${0.29 * s} 0"/></joint>
  <link name="rear_right_corner_guard"><visual><origin xyz="0 0 ${0.12 * s}"/><geometry><cylinder radius="${0.05 * s}" length="${0.24 * s}"/></geometry><material name="guard"><color rgba="0.08 0.09 0.10 1"/></material></visual><collision><origin xyz="0 0 ${0.12 * s}"/><geometry><cylinder radius="${0.05 * s}" length="${0.24 * s}"/></geometry></collision></link>
  <joint name="rear_right_corner_guard_joint" type="fixed"><parent link="base_link"/><child link="rear_right_corner_guard"/><origin xyz="${-0.39 * s} ${-0.29 * s} 0"/></joint>

  <!-- X-arranged roller visuals; four smooth wheel collisions use the equivalent
       free-roller constraints supplied by MecanumContacts in chassis coordinates. -->
  <xacro:macro name="mecanum_roller" params="wheel index hand">
    <xacro:property name="theta" value="${2*pi*index/16}"/>
    <xacro:property name="axis_x" value="${hand*cos(theta)/sqrt(2)}"/>
    <xacro:property name="axis_z" value="${-hand*sin(theta)/sqrt(2)}"/>
    <link name="${wheel}_roller_${index}">
      <visual><geometry><mesh filename="package://hetero_fleet_description/meshes/mecanum_barrel.stl"/></geometry><material name="roller"><color rgba="0.12 0.13 0.15 1"/></material></visual>

    </link>
    <joint name="${wheel}_roller_${index}_joint" type="fixed">
      <parent link="${wheel}_wheel_link"/><child link="${wheel}_roller_${index}"/>
      <origin xyz="${0.057*sin(theta)} 0 ${0.057*cos(theta)}" rpy="0 ${acos(axis_z)} ${atan2(1/sqrt(2),axis_x)}"/>

    </joint>

  </xacro:macro>
  <xacro:macro name="mecanum_wheel" params="name x y hand">
    <link name="${name}_wheel_link">
      <inertial><mass value="0.14"/><inertia ixx="${0.14*(3*0.035**2+wheel_width**2)/12}" ixy="0" ixz="0" iyy="${0.14*0.035**2/2}" iyz="0" izz="${0.14*(3*0.035**2+wheel_width**2)/12}"/></inertial>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.045" length="${wheel_width}"/></geometry><material name="hub"><color rgba="0.04 0.04 0.04 1"/></material></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${name}_wheel_link"/><origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/><dynamics damping="0.002" friction="0"/><limit effort="15" velocity="18"/></joint>
    <xacro:mecanum_roller wheel="${name}" index="0" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="1" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="2" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="3" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="4" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="5" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="6" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="7" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="8" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="9" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="10" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="11" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="12" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="13" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="14" hand="${hand}"/>
    <xacro:mecanum_roller wheel="${name}" index="15" hand="${hand}"/>
  </xacro:macro>
  <xacro:mecanum_wheel name="front_left" x="${base_length/2-0.10*s}" y="${base_width/2+wheel_width/2}" hand="1"/>
  <xacro:mecanum_wheel name="front_right" x="${base_length/2-0.10*s}" y="${-base_width/2-wheel_width/2}" hand="-1"/>
  <xacro:mecanum_wheel name="rear_left" x="${-base_length/2+0.10*s}" y="${base_width/2+wheel_width/2}" hand="-1"/>
  <xacro:mecanum_wheel name="rear_right" x="${-base_length/2+0.10*s}" y="${-base_width/2-wheel_width/2}" hand="1"/>

  <link name="lidar_link">
    <inertial><mass value="0.15"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0003"/></inertial>
    <visual><geometry><cylinder radius="${0.048 * s}" length="${0.05 * s}"/></geometry><material name="lidar"><color rgba="0.12 0.12 0.14 1"/></material></visual><collision><geometry><cylinder radius="${0.048 * s}" length="${0.05 * s}"/></geometry></collision>
  </link>
  <link name="lidar_mount_link"><visual><origin xyz="0 0 ${0.08 * s}"/><geometry><cylinder radius="${0.072 * s}" length="${0.16 * s}"/></geometry><material name="mount"><color rgba="0.14 0.15 0.17 1"/></material></visual><collision><origin xyz="0 0 ${0.08 * s}"/><geometry><cylinder radius="${0.065 * s}" length="${0.14 * s}"/></geometry></collision></link>
  <joint name="lidar_mount_joint" type="fixed"><parent link="omni_deck_link"/><child link="lidar_mount_link"/><origin xyz="${0.18 * s} 0 ${0.07 * s}"/></joint>
  <joint name="lidar_joint" type="fixed"><parent link="lidar_mount_link"/><child link="lidar_link"/><origin xyz="0 0 ${0.14 * s}"/></joint>
  <!-- Lidar height lands at ~0.29 m, inside the map's obstacle band of
       maps/geomap.pgm, so scan and map agree about what is in the way. -->
  <gazebo reference="lidar_link"><sensor name="${robot_name}_lidar" type="gpu_lidar"><always_on>1</always_on><visualize>false</visualize><update_rate>20</update_rate><topic>/${robot_name}/scan</topic><frame_id>lidar_link</frame_id><lidar><scan><horizontal><samples>1080</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.10</min><max>15.0</max><resolution>0.01</resolution></range></lidar></sensor></gazebo>
  <xacro:fleet_gazebo_material link="base_link" rgba="0.78 0.10 0.12 1"/>
  <gazebo><plugin filename="libhetero_mecanum_contacts.so" name="hetero_fleet::MecanumContacts"/></gazebo>
  <xacro:fleet_gazebo_wheel_dynamics link="front_left_wheel_link" mu1="0.01" mu2="1.2" kp="100000" kd="20"/>
  <xacro:fleet_gazebo_wheel_dynamics link="front_right_wheel_link" mu1="0.01" mu2="1.2" kp="100000" kd="20"/>
  <xacro:fleet_gazebo_wheel_dynamics link="rear_left_wheel_link" mu1="0.01" mu2="1.2" kp="100000" kd="20"/>
  <xacro:fleet_gazebo_wheel_dynamics link="rear_right_wheel_link" mu1="0.01" mu2="1.2" kp="100000" kd="20"/>
  <xacro:fleet_ros2_control name="${robot_name}" wheel_joints="${['front_left_wheel_joint', 'front_right_wheel_joint', 'rear_left_wheel_joint', 'rear_right_wheel_joint']}" controller_type="mecanum" controllers_file="${controllers_file}" namespace="${robot_name}"/>
</robot>
