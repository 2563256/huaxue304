<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hetero_fleet_gz</name>
  <version>0.1.0</version>
  <description>Gazebo world, zone markers and spawn launch for the heterogeneous fleet.</description>
  <maintainer email="dev@example.com">fleet dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_physics_vendor</depend>
  <depend>gz_plugin_vendor</depend>

  <exec_depend>hetero_fleet_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- THIS is what puts the converted scan on Gazebo's search path.
         ros_gz_sim builds GZ_SIM_RESOURCE_PATH itself (from exported
         gazebo_model_path entries plus LD_LIBRARY_PATH) and hands it to the
         gz process as additional_env, which overrides anything a launch file
         sets with SetEnvironmentVariable. Without this export the world loads
         with "Unable to find uri[model://geomap_colour_noroof]" and the robots
         drive on an empty ground plane. -->
    <gazebo_ros gazebo_model_path="${prefix}/models" plugin_path="${prefix}/../../lib"/>
  </export>
</package>
